# --- Required in production ---------------------------------------------
NODE_ENV=production
# Long random string used to sign session cookies (e.g. `openssl rand -hex 48`)
JWT_SECRET=
# Where the SQLite database and uploaded files live. On Railway, attach a volume at /data.
DATA_DIR=/data
# Your first administrator account (created on first start if it doesn't exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
# Public URL, used for payment return/notify links and links in emails
PUBLIC_URL=https://your-app.up.railway.app

# --- Demo data ------------------------------------------------------------
# Demo lawyers, clients, officials and cases are seeded on an empty database.
# Set to false before launch so no demo accounts or demo practitioners exist.
SEED_DEMO=true
# Optional: change the shared demo password (hides it from the login page hint)
# DEMO_PASSWORD=

# --- Payments (PayFast) ---------------------------------------------------
# Leave blank to run in test mode (payments marked paid, no money moves).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = sandbox.payfast.co.za, false = live
PAYFAST_SANDBOX=true

# --- Email (SMTP) -----------------------------------------------------------
# Sends password-reset links and copies of notifications (offers, messages, payments,
# consultation changes). Works with Brevo, Mailgun, SendGrid, Microsoft 365, Google Workspace…
# Leave SMTP_HOST blank and emails are only written to the server log (reset links won't arrive).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS); leave blank to decide from the port
# SMTP_SECURE=
MAIL_FROM=LexBridge <no-reply@lexbridge.co.za>

# --- Optional ---------------------------------------------------------------
# PORT=4000
# CORS_ORIGINS=https://www.lexbridge.co.za
